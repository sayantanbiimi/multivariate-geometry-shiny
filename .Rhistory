ui <- fluidPage(
tags$head(tags$title("Ellipses & distance"), tags$style(HTML('
body{background:#f3f6f9;color:#193047;font-family:Arial,sans-serif;}
.container-fluid{max-width:1560px;padding:24px 30px;}
h1{font-weight:700;font-size:32px;margin:0 0 10px;}
h3{font-size:19px;font-weight:700;margin:0 0 15px;}
h4{font-size:16px;font-weight:700;} .intro{color:#596b7d;font-size:16px;}
.panel-card{background:white;border:1px solid #dfe6ed;border-radius:12px;
padding:20px;margin-bottom:18px;box-shadow:0 3px 12px #19304706;}
.status{background:#e4f3f1;border-left:4px solid #008b87;
padding:15px 18px;border-radius:6px;margin:18px 0;font-size:16px;}
.metrics{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:18px;}
.metric{background:white;border:1px solid #dfe6ed;border-radius:10px;
padding:14px 18px;flex:1;min-width:190px;}
.metric strong{font-size:27px;display:block;color:#008b87;}
.metric small{color:#607386;} .btn-primary{background:#008b87;border-color:#008b87;}
.btn{border-radius:7px;margin-right:6px;margin-bottom:6px;}
.help-block,.hint{color:#607386;font-size:13px;}
.shiny-plot-output{cursor:crosshair;} pre{background:#f5f8fb;border:0;}
.formula{font-family:Georgia,serif;font-size:19px;line-height:1.8;}
details summary{cursor:pointer;font-weight:700;padding:8px 0;}
.irs--shiny .irs-bar,.irs--shiny .irs-single{background:#008b87;}
@media(max-width:768px){.container-fluid{padding:15px;}h1{font-size:26px;}}
'))),
h1("Ellipses, covariance & Mahalanobis distance"),
p(class="intro", "Change the covariance, move a point, and see how distance depends on direction."),
tabsetPanel(id="main_tab",
tabPanel("Visualization", value="visualization",
div(class="status", textOutput("narrative")),
uiOutput("metrics"),
fluidRow(
column(6,card("Original / transforming coordinates",plotOutput("original",height="430px",click="left_click"))),
column(6,card("Whitened coordinates",plotOutput("white",height="430px",click="right_click")))
),
p(class="hint", "Coral point: the same observation in both views. Dashed grey circle: equal Euclidean distance in the left view. Orange and purple: principal axes. Both plots use equal aspect ratios; their scale ranges may differ."),
fluidRow(
column(4,card("1. Covariance & centre",
selectInput("preset","Example",c("Correlated: variances 2, 2"="default","Uncorrelated, unequal variances"="diagonal","Strong positive correlation"="positive","Negative correlation"="negative","Spherical covariance"="sphere")),
sliderInput("v1","Variance of X1",.2,6,2,step=.1),
sliderInput("v2","Variance of X2",.2,6,2,step=.1),
sliderInput("rho","Correlation",-.95,.95,.5,step=.01),
fluidRow(column(6,numericInput("mu1","Mean of X1",0,min=-5,max=5,step=.25)),column(6,numericInput("mu2","Mean of X2",0,min=-5,max=5,step=.25))),
checkboxInput("axes","Show principal axes",TRUE),
checkboxInput("sample","Show illustrative point cloud",FALSE)
)),
column(4,card("2. Move & animate",
selectInput("mode","Demonstration",c("Explore / click a point"="explore","Walk around a contour"="walk","Circles to ellipses"="build","Whitening: ellipses to circles"="whiten","Guided tour: all three stages"="tour")),
actionButton("play","Play",class="btn-primary"),actionButton("reset","Reset motion"),
sliderInput("speed","Animation speed",.5,2,1,step=.25),
sliderInput("angle","Point angle in whitened coordinates",0,360,35,step=1),
sliderInput("progress","Transformation progress (when paused)",0,1,0,step=.01),
p(class="hint","Click either plot to choose a point in Explore mode. Other modes keep its Mahalanobis radius fixed. Play in Explore starts a contour walk."),
uiOutput("motion_note")
)),
column(4,card("3. Contours & display",
radioButtons("radius_mode","Choose the highlighted contour by",c("Mahalanobis radius"="radius","Enclosed normal probability"="probability")),
conditionalPanel("input.radius_mode == 'radius'",sliderInput("radius","Mahalanobis radius",0,3.5,2,step=.05)),
conditionalPanel("input.radius_mode == 'probability'",sliderInput("prob","Enclosed probability (%)",5,99,95,step=1)),
selectInput("contours","Background contours",c("Probability: 50%, 80%, 95%"="probability","Distance: 1, 2, 3"="distance")),
checkboxInput("euclidean","Show Euclidean comparison circle",TRUE),
downloadButton("figure","Save plots (PNG)"),
downloadButton("values","Save current values (CSV)"),
p(class="hint","The view fits the contours and point automatically. Probabilities assume a bivariate normal distribution.")
))
)
),
tabPanel("Computations", value="computations",
br(),
uiOutput("metrics"),
card("Matrices, coordinates and distances",
fluidRow(column(6,verbatimTextOutput("matrices")),column(6,verbatimTextOutput("calculation")))),
)
)
)
server <- function(input,output,session) {
running <- reactiveVal(FALSE)
start_on_mode_change <- reactiveVal(FALSE)
phase <- reactiveVal(0)
selected <- reactiveVal(NULL) # a clicked point represented in white coordinates
observeEvent(input$preset, {
p <- switch(input$preset,default=c(2,2,.5),diagonal=c(4,1,0),positive=c(2,2,.9),negative=c(2,2,-.75),sphere=c(2,2,0))
updateSliderInput(session,"v1",value=p[1]); updateSliderInput(session,"v2",value=p[2]); updateSliderInput(session,"rho",value=p[3])
})
target <- reactive({
req(input$v1,input$v2, !is.null(input$rho), !is.null(input$mu1), !is.null(input$mu2))
validate(need(all(is.finite(c(input$v1,input$v2,input$rho,input$mu1,input$mu2))),"Enter finite numeric values."))
S <- matrix(c(input$v1,input$rho*sqrt(input$v1*input$v2),input$rho*sqrt(input$v1*input$v2),input$v2),2)
e <- eigen(S,symmetric=TRUE)
validate(need(min(e$values)>0,"Covariance must be positive definite."))
Q <- e$vectors
for(j in 1:2) if(Q[which.max(abs(Q[,j])),j]<0) Q[,j] <- -Q[,j]
list(S=S,Q=Q,lambda=e$values,root=Q%*%diag(sqrt(e$values))%*%t(Q),mu=c(input$mu1,input$mu2))
})
rad <- reactive(if(input$radius_mode=="radius") input$radius else sqrt(qchisq(input$prob/100,2)))
observeEvent(list(input$radius,input$prob,input$radius_mode,input$angle),selected(NULL),ignoreInit=TRUE)
observeEvent(input$mode,{
running(isolate(start_on_mode_change()));start_on_mode_change(FALSE)
phase(0);selected(NULL)
},ignoreInit=TRUE)
observeEvent(input$progress,{if(!running()) phase(input$progress)},ignoreInit=TRUE)
observeEvent(input$play,{
if(input$mode=="explore") {
start_on_mode_change(TRUE)
updateSelectInput(session,"mode",selected="walk")
} else running(!running())
})
observe({updateActionButton(session,"play",label=if(running()) "Pause" else "Play")})
observeEvent(input$reset,{running(FALSE);phase(0);selected(NULL);updateSliderInput(session,"progress",value=0);updateSliderInput(session,"angle",value=35)})
observe({
req(running())
invalidateLater(100,session)
isolate({
cap <- if(input$mode=="tour") 3 else 1
next_p <- phase()+.01*input$speed
if(input$mode %in% c("build","whiten") && next_p>=1) {phase(1);running(FALSE)}
else phase(next_p %% cap)
})
})
scene <- reactive({
a <- target(); mode <- input$mode; p <- phase()
if(mode=="tour") {
stage <- min(2,floor(p)); t <- p-stage
mode <- c("build","walk","whiten")[stage+1]
} else t <- p
B <- switch(mode,build=(1-t)*diag(2)+t*a$root,whiten=(1-t)*a$root+t*diag(2),a$root)
theta <- input$angle*pi/180 + if(mode=="walk") 2*pi*t else 0
z <- if(input$mode=="explore" && !is.null(selected())) selected() else rad()*c(cos(theta),sin(theta))
S <- B%*%t(B); y <- as.vector(B%*%z)
rs <- if(input$contours=="probability") sqrt(qchisq(c(.5,.8,.95),2)) else c(1,2,3)
labs <- if(input$contours=="probability") c("50%","80%","95%") else c("r = 1","r = 2","r = 3")
list(a=a,B=B,S=S,z=z,y=y,x=a$mu+y,mode=mode,t=t,rs=rs,labs=labs,
dm=sqrt(sum(z*z)),de=sqrt(sum(y*y)))
})
observeEvent(input$left_click,{
req(input$mode=="explore",!running(),is.finite(input$left_click$x),is.finite(input$left_click$y))
s <- scene(); selected(as.vector(solve(s$B,c(input$left_click$x,input$left_click$y)-s$a$mu)))
})
observeEvent(input$right_click,{
req(input$mode=="explore",!running(),is.finite(input$right_click$x),is.finite(input$right_click$y))
selected(c(input$right_click$x,input$right_click$y))
})
output$narrative <- renderText({
s<-scene()
switch(s$mode,explore="Explore: click either plot. Whitening links the two positions; Mahalanobis distance on the left equals Euclidean distance on the right.",
walk="Contour walk: the point stays at a fixed Mahalanobis distance. Its Euclidean distance generally changes as it travels around the ellipse.",
build=sprintf("Circles to ellipses · %d%%: covariance grows from I to Σ. The current covariance is used to measure distance.",round(100*s$t)),
whiten=sprintf("Whitening · %d%%: the left covariance approaches I. The two views agree up to the mean translation when the transformation finishes.",round(100*s$t)))
})
output$motion_note <- renderUI({
s<-scene()
p(class="hint",sprintf("Current stage: %s · progress %.0f%%. The contour controls reset a clicked point.",s$mode,100*s$t))
})
output$metrics <- renderUI({
s<-scene()
metric<-function(label,value,note) div(class="metric",span(label),strong(value),tags$small(note))
div(class="metrics",
metric("Euclidean distance · left",fmt(s$de),"Distance from the displayed mean"),
metric("Mahalanobis distance · left",fmt(s$dm),"Uses the displayed covariance"),
metric("Euclidean distance · whitened",fmt(s$dm),"Exactly equal to Mahalanobis distance"),
metric("Probability inside point's contour",paste0(fmt(100*pchisq(s$dm^2,2)),"%"),"Bivariate normal model"))
})
draw_plot <- function(s,white=FALSE) {
B<-if(white) diag(2) else s$B; mu<-if(white) c(0,0) else s$a$mu
point<-if(white) s$z else s$x
maxr<-max(s$rs,s$dm,rad(),.5)
lim<-1.18*maxr*max(sqrt(rowSums(B^2)))
if(!white && input$euclidean) lim<-max(lim,1.1*s$de)
par(mar=c(4,4,3,1),fg=ink,col.axis=ink,col.lab=ink,bg="white",xaxs="i",yaxs="i")
plot(NA,xlim=mu[1]+c(-lim,lim),ylim=mu[2]+c(-lim,lim),asp=1,
xlab=if(white) "z1" else "x1",ylab=if(white) "z2" else "x2",
main=if(white) "Identity covariance" else if(s$mode %in% c("build","whiten")) "Current covariance S(t)" else "Covariance Σ")
grid(col="#edf1f5"); abline(v=mu[1],h=mu[2],col="#c8d3de",lwd=1)
if(input$sample) {d<-sweep(B%*%cloud,1,mu,"+");points(t(d),pch=16,cex=.45,col=adjustcolor(teal,alpha.f=.18))}
palette<-c("#abcfcf","#62b7b2",teal)
for(i in seq_along(s$rs)) {v<-sweep(s$rs[i]*B%*%circle,1,mu,"+");lines(t(v),col=palette[i],lwd=2)}
if(s$dm>1e-8) {v<-sweep(s$dm*B%*%circle,1,mu,"+");lines(t(v),col=red,lwd=2,lty=2)}
if(!white && input$euclidean) {v<-sweep(s$de*circle,1,mu,"+");lines(t(v),col="#929faa",lty=3,lwd=1.5)}
eig<-eigen(B%*%t(B),symmetric=TRUE)
# Keep target eigenvector orientation stable throughout the animations.
if(input$axes && !white && diff(range(eig$values))>1e-8) {
Q<-s$a$Q
for(j in 1:2) {
u<-Q[,j]; length<-max(s$rs)*sqrt(as.numeric(t(u)%*%(B%*%t(B))%*%u))
lo<-mu-length*u;hi<-mu+length*u
arrows(lo[1],lo[2],hi[1],hi[2],code=3,length=.08,col=c(orange,purple)[j],lwd=2)
}
}
if(sum((point-mu)^2)>1e-12) arrows(mu[1],mu[2],point[1],point[2],length=.09,col=red,lwd=2)
points(mu[1],mu[2],pch=3,col=ink,lwd=2,cex=1.2)
points(point[1],point[2],pch=21,bg=red,col="white",cex=1.5,lwd=1.5)
legend("topleft",legend=s$labs,col=palette,lty=1,lwd=2,bty="n",cex=.82,bg="white")
box(col="#c8d3de")
}
output$original<-renderPlot({draw_plot(scene())},res=110)
output$white<-renderPlot({draw_plot(scene(),TRUE)},res=110)
output$matrices<-renderPrint({
s<-scene(); cat("Target covariance Σ\n");print(round(s$a$S,4))
cat("\nTarget eigenvalues (largest first)\n");print(round(s$a$lambda,4))
cat("\nTarget eigenvectors (columns)\n");print(round(s$a$Q,4))
if(diff(range(s$a$lambda))<1e-8) cat("Equal eigenvalues: every orthonormal basis is valid.\n")
cat("\nCurrent covariance S(t)\n");print(round(s$S,4))
cat("\nCurrent whitening matrix S(t)^(-1/2)\n");print(round(solve(s$B),4))
})
output$calculation<-renderPrint({
s<-scene();proj<-as.vector(t(s$a$Q)%*%s$y)
lam<-diag(t(s$a$Q)%*%s$S%*%s$a$Q)
cat("Mean μ:             ",paste(fmt(s$a$mu),collapse=", "),"\n")
cat("Displayed point x:  ",paste(fmt(s$x),collapse=", "),"\n")
cat("Whitened point z:   ",paste(fmt(s$z),collapse=", "),"\n\n")
cat("Euclidean² (left) = ",fmt(sum(s$y^2)),"\n")
cat("Mahalanobis²      = ",fmt(sum(s$y*solve(s$S,s$y))),"\n")
cat("Euclidean² (z)    = ",fmt(sum(s$z^2)),"\n\n")
cat("Squared standardized principal coordinates:\n")
cat(paste(fmt(proj^2/lam),collapse=" + ")," = ",fmt(s$dm^2),"\n\n")
cat("Probability within point's contour: ",fmt(pchisq(s$dm^2,2)),"\n")
cat("Current principal semiaxes for that contour:\n")
print(round(s$dm*sqrt(lam),4))
})
output$figure<-downloadHandler(filename=function() "Mahalanobis_Contours.png",content=function(file){
s<-scene();png(file,width=1800,height=850,res=150);on.exit(dev.off(),add=TRUE)
par(mfrow=c(1,2));draw_plot(s);draw_plot(s,TRUE)
})
output$values<-downloadHandler(filename=function() "Mahalanobis_Values.csv",content=function(file){
s<-scene()
d<-data.frame(stage=s$mode,progress=s$t,mu1=s$a$mu[1],mu2=s$a$mu[2],
target_variance1=s$a$S[1,1],target_variance2=s$a$S[2,2],target_covariance=s$a$S[1,2],
current_variance1=s$S[1,1],current_variance2=s$S[2,2],current_covariance=s$S[1,2],
x1=s$x[1],x2=s$x[2],z1=s$z[1],z2=s$z[2],euclidean=s$de,mahalanobis=s$dm,
normal_enclosed_probability=pchisq(s$dm^2,2))
write.csv(d,file,row.names=FALSE)
})
}
shinyApp(ui,server)
# Ellipses, covariance and Mahalanobis distance
# Save as app.R. In R / RStudio:
#   install.packages("shiny")  # once
#   shiny::runApp("path/to/the/folder/containing/app.R")
# Only Shiny is required; plotting and matrix calculations use base R.
# This is a bivariate NORMAL illustration. Probability contours describe
# population probability regions, not confidence regions for the mean.
library(shiny)
ink <- "#193047"; teal <- "#008b87"; orange <- "#cd6a12"
purple <- "#7952ae"; red <- "#d54b54"
circle <- rbind(cos(seq(0, 2*pi, length.out=361)),
sin(seq(0, 2*pi, length.out=361)))
cloud <- local({
# Deterministic normal quantiles: no session-global random seed changes.
i <- seq_len(420)
rbind(qnorm((i-.5)/420), qnorm((((i*163) %% 420)+.5)/420))
})
fmt <- function(x) formatC(x, digits=3, format="f")
card <- function(title, ...) div(class="panel-card", h3(title), ...)
